      38/       0 :                     
      39/       0 :                     ; ===========================================================================
      40/       0 :                     ; Expressing sprite mappings and DPLCs in a portable and human-readable form
      41/       0 : =$2                  SonicMappingsVer = 2
      42/       0 : =$2                  SonicDplcVer = 2
      43/       0 :                     	include	"mappings/MapMacros.asm"
(1)    1/       0 :                     ; macro to declare a mappings table (taken from Sonic 2 Hg disassembly)
(1)    2/       0 :                     mappingsTable macro {INTLABEL}
(1)    3/       0 :                     __LABEL__ label *
(1)    4/       0 :                     .current_mappings_table := __LABEL__
(1)    5/       0 :                         endm
(1)    6/       0 :                     
(1)    7/       0 :                     ; macro to declare an entry in a mappings table (taken from Sonic 2 Hg disassembly)
(1)    8/       0 :                     mappingsTableEntry macro ptr
(1)    9/       0 :                     	dc.ATTRIBUTE ptr-.current_mappings_table
(1)   10/       0 :                         endm
(1)   11/       0 :                     
(1)   12/       0 :                     spriteHeader macro {INTLABEL}
(1)   13/       0 :                     __LABEL__ label *
(1)   14/       0 :                     	if SonicMappingsVer=1
(1)   15/       0 :                     	dc.b ((__LABEL___End - __LABEL___Begin) / 5)
(1)   16/       0 :                     	elseif SonicMappingsVer=2
(1)   17/       0 :                     	dc.w ((__LABEL___End - __LABEL___Begin) / 8)
(1)   18/       0 :                     	else
(1)   19/       0 :                     	dc.w ((__LABEL___End - __LABEL___Begin) / 6)
(1)   20/       0 :                     	endif
(1)   21/       0 :                     __LABEL___Begin label *
(1)   22/       0 :                         endm
(1)   23/       0 :                     
(1)   24/       0 :                     spritePiece macro xpos,ypos,width,height,tile,xflip,yflip,pal,pri
(1)   25/       0 :                     	if SonicMappingsVer=1
(1)   26/       0 :                     	dc.b	ypos
(1)   27/       0 :                     	dc.b	(((width-1)&3)<<2)|((height-1)&3)
(1)   28/       0 :                     	dc.b	((((pri&1)<<15)|((pal&3)<<13)|((yflip&1)<<12)|((xflip&1)<<11))+(tile))>>8
(1)   29/       0 :                     	dc.b	tile&$FF
(1)   30/       0 :                     	dc.b	xpos
(1)   31/       0 :                     	elseif SonicMappingsVer=2
(1)   32/       0 :                     	dc.w	((ypos&$FF)<<8)|(((width-1)&3)<<2)|((height-1)&3)
(1)   33/       0 :                     	dc.w	(((pri&1)<<15)|((pal&3)<<13)|((yflip&1)<<12)|((xflip&1)<<11))+(tile)
(1)   34/       0 :                     	dc.w	(((pri&1)<<15)|((pal&3)<<13)|((yflip&1)<<12)|((xflip&1)<<11))+(((tile)>>1)|((tile)&$8000))
(1)   35/       0 :                     	dc.w	xpos
(1)   36/       0 :                     	else
(1)   37/       0 :                     	dc.w	((ypos&$FF)<<8)|(((width-1)&3)<<2)|((height-1)&3)
(1)   38/       0 :                     	dc.w	(((pri&1)<<15)|((pal&3)<<13)|((yflip&1)<<12)|((xflip&1)<<11))+(tile)
(1)   39/       0 :                     	dc.w	xpos
(1)   40/       0 :                     	endif
(1)   41/       0 :                     	endm
(1)   42/       0 :                     
(1)   43/       0 :                     spritePiece2P macro xpos,ypos,width,height,tile,xflip,yflip,pal,pri,tile2,xflip2,yflip2,pal2,pri2
(1)   44/       0 :                     	if SonicMappingsVer=1
(1)   45/       0 :                     	dc.b	ypos
