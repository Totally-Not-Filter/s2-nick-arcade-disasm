   13817/   418A8 :                     ; ---------------------------------------------------------------------------
   13818/   418A8 :                     ; Leftover symbol tables due to compiler weirdness; these are formatted
   13819/   418A8 :                     ; with a Unix ($0A) line break instead of a DOS ($0D0A) line break and it's
   13820/   418A8 :                     ; also using big-endian integers, which suggest Sonic 2 wasn't developed in
   13821/   418A8 :                     ; DOS (or at least a little-endian environment.)
   13822/   418A8 :                     ; in addition, the locations that can be extracted don't even match up with
   13823/   418A8 :                     ; the prototype.
   13824/   418A8 :                     ;
   13825/   418A8 :                     ; Read more about it here:
   13826/   418A8 :                     ; https://clownacy.wordpress.com/2022/03/30/everything-that-i-know-about-sonic-the-hedgehogs-source-code/
   13827/   418A8 :                     ; https://tcrf.net/Proto:Sonic_the_Hedgehog_2_(Genesis)/Nick_Arcade_Prototype/Symbol_Tables
   13828/   418A8 :                     ; ---------------------------------------------------------------------------
   13829/   418A8 :                     		binclude	"leftovers/symbols/symbol1.bin"
