    3839/    547A :                     SSBGData:	macro time,anim,vram,index,flag1,flag2
    3840/    547A :                     		dc.b	(time), (anim), ((vram)*tile_size)>>13
    3841/    547A :                     	if flag1
    3842/    547A :                     		dc.b	(index)|$80|(flag2)
    3843/    547A :                     	else
    3844/    547A :                     		dc.b	(index)*12
    3845/    547A :                     	endif
    3846/    547A :                     		endm
    3847/    547A :                     
