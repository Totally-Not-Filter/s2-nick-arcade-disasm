   16672/   80000 :                     
   16673/   80000 :                     ; ---------------------------------------------------------------------------
   16674/   80000 :                     ; Uncompressed graphics - Sonic and Tails
   16675/   80000 :                     ; ---------------------------------------------------------------------------
   16676/   80000 :                     ; This must be aligned to a bank in order to avoid issues with the DMA.
   16677/   80000 :                     ; But because all of the art is placed after the sound driver which already aligns with the bank,
   16678/   80000 :                     ; this fixes itself.
   16679/   80000 :                     ; The exact location in ROM that this is located at is 0x80000.
   16681/   80000 :                     	; Ensure properly art alignment, unnessesary if the DMA bug fix is enabled for 128kb boundaries.
   16682/   80000 : (MACRO)              	align $8000
   16682/   80000 :  (MACRO-2)                   cnop 0,$8000
   16682/   80000 :   (MACRO-3)                          org (*-1+($8000)-((*-1+(-(0)))#($8000)))
   16682/   80000 :                                             !org (*-1+($8000)-((*-1+(-(0)))#($8000)))
   16684/   80000 :                     Art_Sonic:	binclude	"art/uncompressed/Sonic's art.bin"
