    9771/    F598 :                     ; loc_F598:
    9772/    F598 :                     SolidObject_cont:
    9773/    F598 :                     		; We now perform the x portion of a bounding box check.  To do this, we assume a
    9774/    F598 :                     		; coordinate system where the x origin is at the object's left edge.
    9775/    F598 : 3029 0008           		move.w	obX(a1),d0			; load Sonic's x position...
    9776/    F59C : 9068 0008           		sub.w	obX(a0),d0			; ... and calculate his x position relative to the object
    9777/    F5A0 : D041                		add.w	d1,d0				; assume object's left edge is at (0,0).  This is also Sonic's distance to the object's left edge.
    9778/    F5A2 : 6B00 00C4           		bmi.w	SolidObject_TestClearPush	; branch, if Sonic is outside the object's left edge
    9779/    F5A6 : 3601                		move.w	d1,d3
    9780/    F5A8 : D643                		add.w	d3,d3				; calculate object's width
    9781/    F5AA : B043                		cmp.w	d3,d0
    9782/    F5AC : 6200 00BA           		bhi.w	SolidObject_TestClearPush	; branch, if Sonic is outside the object's right edge
    9783/    F5B0 :                     		; We now perform the y portion of a bounding box check.  To do this, we assume a
    9784/    F5B0 :                     		; coordinate system where the y origin is at the highest y position relative to the object
    9785/    F5B0 :                     		; at which Sonic would still collide with it.  This point is
    9786/    F5B0 :                     		;   y_pos(object) - width(object)/2 - y_radius(Sonic) - 4,
    9787/    F5B0 :                     		; where object is stored in (a0), Sonic in (a1), and height(object)/2 in d2.  This way
    9788/    F5B0 :                     		; of doing it causes the object's hitbox to be vertically off-center by -4 pixels.
    9789/    F5B0 : 1629 0016           		move.b	obHeight(a1),d3			; load Sonic's y radius
    9790/    F5B4 : 4883                		ext.w	d3
    9791/    F5B6 : D443                		add.w	d3,d2				; calculate maximum distance for a top collision
    9792/    F5B8 : 3629 000C           		move.w	obY(a1),d3			; load Sonic's y position
    9793/    F5BC : 9668 000C           		sub.w	obY(a0),d3			; ... and calculate his y position relative to the object
    9794/    F5C0 : 5843                		addq.w	#4,d3				; assume a slightly lower position for Sonic
    9795/    F5C2 : D642                		add.w	d2,d3				; assume the highest position where Sonic would still be colliding with the object to be (0,0)
    9796/    F5C4 : 6B00 00A2           		bmi.w	SolidObject_TestClearPush	; branch, if Sonic is above this point
    9797/    F5C8 : 3802                		move.w	d2,d4
    9798/    F5CA : D844                		add.w	d4,d4				; calculate minimum distance for a bottom collision
    9799/    F5CC : B644                		cmp.w	d4,d3
    9800/    F5CE : 6400 0098           		bhs.w	SolidObject_TestClearPush	; branch, if Sonic is below this point
    9801/    F5D2 :                     ; loc_F5D2:
