(2)   18/   745DC :                     ; PSG conversion to S3/S&K/S3D drivers require a tone shift of 12 semi-tones.
(2)   19/   745DC : =$C                  psgdelta	EQU 12
(2)   20/   745DC :                     ; ---------------------------------------------------------------------------
(2)   21/   745DC :                     ; Standard Octave Pitch Equates
(2)   22/   745DC :                     	enumconf	$C
(2)   23/   745DC : =$88..$B8            	enum		smpsPitch10lo=$88,smpsPitch09lo,smpsPitch08lo,smpsPitch07lo,smpsPitch06lo
(2)   24/   745DC : =$C4..$F4            	nextenum	smpsPitch05lo,smpsPitch04lo,smpsPitch03lo,smpsPitch02lo,smpsPitch01lo
(2)   25/   745DC : =$0..$30             	enum		smpsPitch00=$00,smpsPitch01hi,smpsPitch02hi,smpsPitch03hi,smpsPitch04hi
(2)   26/   745DC : =$3C..$6C            	nextenum	smpsPitch05hi,smpsPitch06hi,smpsPitch07hi,smpsPitch08hi,smpsPitch09hi
(2)   27/   745DC : =$78                 	nextenum	smpsPitch10hi
(2)   28/   745DC :                     	enumconf	1
(2)   29/   745DC :                     ; ---------------------------------------------------------------------------
(2)   30/   745DC :                     ; Note Equates
(2)   31/   745DC : =$80                 	enum		nRst=$80
(2)   32/   745DC : =$81..$86            	nextenum	nC0,nCs0,nDb0=nCs0,nD0,nDs0,nEb0=nDs0,nE0,nFb0=nE0,nEs0,nF0=nEs0
(2)   33/   745DC : =$87..$8D            	nextenum	nFs0,nGb0=nFs0,nG0,nGs0,nAb0=nGs0,nA0,nAs0,nBb0=nAs0,nB0,nCb1=nB0,nBs0
(2)   34/   745DC : =$8D..$92            	nextenum	nC1=nBs0,nCs1,nDb1=nCs1,nD1,nDs1,nEb1=nDs1,nE1,nFb1=nE1,nEs1,nF1=nEs1
(2)   35/   745DC : =$93..$99            	nextenum	nFs1,nGb1=nFs1,nG1,nGs1,nAb1=nGs1,nA1,nAs1,nBb1=nAs1,nB1,nCb2=nB1,nBs1
(2)   36/   745DC : =$99..$9E            	nextenum	nC2=nBs1,nCs2,nDb2=nCs2,nD2,nDs2,nEb2=nDs2,nE2,nFb2=nE2,nEs2,nF2=nEs2
(2)   37/   745DC : =$9F..$A5            	nextenum	nFs2,nGb2=nFs2,nG2,nGs2,nAb2=nGs2,nA2,nAs2,nBb2=nAs2,nB2,nCb3=nB2,nBs2
(2)   38/   745DC : =$A5..$AA            	nextenum	nC3=nBs2,nCs3,nDb3=nCs3,nD3,nDs3,nEb3=nDs3,nE3,nFb3=nE3,nEs3,nF3=nEs3
(2)   39/   745DC : =$AB..$B1            	nextenum	nFs3,nGb3=nFs3,nG3,nGs3,nAb3=nGs3,nA3,nAs3,nBb3=nAs3,nB3,nCb4=nB3,nBs3
(2)   40/   745DC : =$B1..$B6            	nextenum	nC4=nBs3,nCs4,nDb4=nCs4,nD4,nDs4,nEb4=nDs4,nE4,nFb4=nE4,nEs4,nF4=nEs4
(2)   41/   745DC : =$B7..$BD            	nextenum	nFs4,nGb4=nFs4,nG4,nGs4,nAb4=nGs4,nA4,nAs4,nBb4=nAs4,nB4,nCb5=nB4,nBs4
(2)   42/   745DC : =$BD..$C2            	nextenum	nC5=nBs4,nCs5,nDb5=nCs5,nD5,nDs5,nEb5=nDs5,nE5,nFb5=nE5,nEs5,nF5=nEs5
(2)   43/   745DC : =$C3..$C9            	nextenum	nFs5,nGb5=nFs5,nG5,nGs5,nAb5=nGs5,nA5,nAs5,nBb5=nAs5,nB5,nCb6=nB5,nBs5
(2)   44/   745DC : =$C9..$CE            	nextenum	nC6=nBs5,nCs6,nDb6=nCs6,nD6,nDs6,nEb6=nDs6,nE6,nFb6=nE6,nEs6,nF6=nEs6
(2)   45/   745DC : =$CF..$D5            	nextenum	nFs6,nGb6=nFs6,nG6,nGs6,nAb6=nGs6,nA6,nAs6,nBb6=nAs6,nB6,nCb7=nB6,nBs6
(2)   46/   745DC : =$D5..$DA            	nextenum	nC7=nBs6,nCs7,nDb7=nCs7,nD7,nDs7,nEb7=nDs7,nE7,nFb7=nE7,nEs7,nF7=nEs7
(2)   47/   745DC : =$DB..$DF            	nextenum	nFs7,nGb7=nFs7,nG7,nGs7,nAb7=nGs7,nA7,nAs7,nBb7=nAs7
(2)   48/   745DC :                     ; SMPS2ASM uses nMaxPSG for songs from S1/S2 drivers.
(2)   49/   745DC :                     ; nMaxPSG1 and nMaxPSG2 are used only for songs from S3/S&K/S3D drivers.
(2)   50/   745DC :                     ; The use of psgdelta is intended to undo the effects of PSGPitchConvert
(2)   51/   745DC :                     ; and ensure that the ending note is indeed the maximum PSG frequency.
(2)   53/   745DC : =$C6                 nMaxPSG				EQU nA5
(2)   54/   745DC : =$D2                 nMaxPSG1			EQU nA5+psgdelta
(2)   55/   745DC : =$D2                 nMaxPSG2			EQU nA5+psgdelta
(2)   61/   745DC :                     ; ---------------------------------------------------------------------------
(2)   62/   745DC :                     ; PSG volume envelope equates
(2)   65/   745DC : =$1..$6              			enum		fTone_01=$01,fTone_02,fTone_03,fTone_04,fTone_05,fTone_06
(2)   66/   745DC : =$7..$9              			nextenum	fTone_07,fTone_08,fTone_09
(2)   86/   745DC :                     ; ---------------------------------------------------------------------------
(2)   87/   745DC :                     ; DAC Equates
(2)   90/   745DC : =$81..$83            			enum		dKick=$81,dSnare,dTimpani
(2)   91/   745DC : =$88..$8B            			enum		dHiTimpani=$88,dMidTimpani,dLowTimpani,dVLowTimpani
(2)  169/   745DC :                     ; ---------------------------------------------------------------------------
(2)  170/   745DC :                     ; Channel IDs for SFX
(2)  171/   745DC : =$80                 cPSG1				EQU $80
(2)  172/   745DC : =$A0                 cPSG2				EQU $A0
(2)  173/   745DC : =$C0                 cPSG3				EQU $C0
(2)  174/   745DC : =$E0                 cNoise				EQU $E0	; Not for use in S3/S&K/S3D
(2)  175/   745DC : =$2                  cFM3				EQU $02
(2)  176/   745DC : =$4                  cFM4				EQU $04
(2)  177/   745DC : =$5                  cFM5				EQU $05
(2)  178/   745DC : =$6                  cFM6				EQU $06	; Only in S3/S&K/S3D, overrides DAC
(2)  179/   745DC :                     ; ---------------------------------------------------------------------------
(2)  180/   745DC :                     ; Conversion macros and functions
(2)  181/   745DC :                     
(2)  182/   745DC :                     conv0To256  function n,((n==0)<<8)|n
(2)  183/   745DC :                     s2TempotoS1 function n,(((768-n)>>1)/(256-n))&$FF
(2)  184/   745DC :                     s2TempotoS3 function n,($100-((n==0)|n))&$FF
(2)  185/   745DC :                     s1TempotoS2 function n,((((conv0To256(n)-1)<<8)+(conv0To256(n)>>1))/conv0To256(n))&$FF
(2)  186/   745DC :                     s1TempotoS3 function n,s2TempotoS3(s1TempotoS2(n))
(2)  187/   745DC :                     s3TempotoS1 function n,s2TempotoS1(s2TempotoS3(n))
(2)  188/   745DC :                     s3TempotoS2 function n,s2TempotoS3(n)
(2)  189/   745DC :                     
(2)  190/   745DC :                     convertMainTempoMod macro mod
(2)  191/   745DC :                     	if ((SourceDriver>=3)&&(SonicDriverVer>=3))||(SonicDriverVer==SourceDriver)
(2)  192/   745DC :                     		dc.b	mod
(2)  193/   745DC :                     	elseif SourceDriver==1
(2)  194/   745DC :                     		if mod==1
(2)  195/   745DC :                     			fatal "Invalid main tempo of 1 in song from Sonic 1"
(2)  196/   745DC :                     		endif
(2)  197/   745DC :                     		if SonicDriverVer==2
(2)  198/   745DC :                     			dc.b	s1TempotoS2(mod)
(2)  199/   745DC :                     		else;if SonicDriverVer>=3
(2)  200/   745DC :                     			dc.b	s1TempotoS3(mod)
(2)  201/   745DC :                     		endif
(2)  202/   745DC :                     	elseif SourceDriver==2
(2)  203/   745DC :                     		if mod==0
(2)  204/   745DC :                     			fatal "Invalid main tempo of 0 in song from Sonic 2"
(2)  205/   745DC :                     		endif
(2)  206/   745DC :                     		if SonicDriverVer==1
(2)  207/   745DC :                     			dc.b	s2TempotoS1(mod)
(2)  208/   745DC :                     		else;if SonicDriverVer>=3
(2)  209/   745DC :                     			dc.b	s2TempotoS3(mod)
(2)  210/   745DC :                     		endif
(2)  211/   745DC :                     	else;if SourceDriver>=3
(2)  212/   745DC :                     		if mod==0
(2)  213/   745DC :                     			message "Performing approximate conversion of Sonic 3 main tempo modifier of 0"
(2)  214/   745DC :                     		endif
(2)  215/   745DC :                     		if SonicDriverVer==1
(2)  216/   745DC :                     			dc.b	s3TempotoS1(mod)
(2)  217/   745DC :                     		else;if SonicDriverVer==2
(2)  218/   745DC :                     			dc.b	s3TempotoS2(mod)
(2)  219/   745DC :                     		endif
(2)  220/   745DC :                     	endif
(2)  221/   745DC :                     	endm
(2)  222/   745DC :                     
(2)  223/   745DC :                     ; PSG conversion to S3/S&K/S3D drivers require a tone shift of 12 semi-tones.
(2)  224/   745DC :                     PSGPitchConvert macro pitch
(2)  225/   745DC :                     	if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  226/   745DC :                     		dc.b	(pitch+psgdelta)&$FF
(2)  227/   745DC :                     	elseif (SonicDriverVer<3)&&(SourceDriver>=3)
(2)  228/   745DC :                     		dc.b	(pitch-psgdelta)&$FF
(2)  229/   745DC :                     	else
(2)  230/   745DC :                     		dc.b	pitch
(2)  231/   745DC :                     	endif
(2)  232/   745DC :                     	endm
(2)  233/   745DC :                     
(2)  234/   745DC :                     CheckedChannelPointer macro loc
(2)  235/   745DC :                     	if SonicDriverVer<>1
(2)  236/   745DC :                     		dc.w	z80_ptr(loc)
(2)  237/   745DC :                     	else
(2)  238/   745DC :                     		if (MOMPASS=1)&&(DEFINED(loc))
(2)  239/   745DC :                     			fatal "Tracks for Sonic 1 songs must come after the start of the song"
(2)  240/   745DC :                     		endif
(2)  241/   745DC :                     		dc.w	loc-songStart
(2)  242/   745DC :                     	endif
(2)  243/   745DC :                     	endm
(2)  244/   745DC :                     ; ---------------------------------------------------------------------------
(2)  245/   745DC :                     ; Header Macros
(2)  246/   745DC :                     smpsHeaderStartSong macro ver, sourcesmps2asmver
(2)  247/   745DC :                     
(2)  248/   745DC :                     SourceDriver set ver
(2)  249/   745DC :                     
(2)  250/   745DC :                     	if ("sourcesmps2asmver"<>"")
(2)  251/   745DC :                     		set SourceSMPS2ASM,sourcesmps2asmver
(2)  252/   745DC :                     	else
(2)  253/   745DC :                     		set SourceSMPS2ASM,0
(2)  254/   745DC :                     	endif
(2)  255/   745DC :                     
(2)  256/   745DC :                     songStart set *
(2)  257/   745DC :                     
(2)  258/   745DC :                     	if MOMPASS=1
(2)  259/   745DC :                     		if SMPS2ASMVer < SourceSMPS2ASM
(2)  260/   745DC :                     			message "Song at 0x\{songStart} was made for a newer version of SMPS2ASM (this is version \{SMPS2ASMVer}, but song wants at least version \{SourceSMPS2ASM})."
(2)  261/   745DC :                     		endif
(2)  262/   745DC :                     	endif
(2)  263/   745DC :                     
(2)  264/   745DC :                     	endm
(2)  265/   745DC :                     
(2)  266/   745DC :                     smpsHeaderVoiceNull macro
(2)  267/   745DC :                     	if songStart<>*
(2)  268/   745DC :                     		fatal "Missing smpsHeaderStartSong"
(2)  269/   745DC :                     	endif
(2)  270/   745DC :                     	dc.w	$0000
(2)  271/   745DC :                     	endm
(2)  272/   745DC :                     
(2)  273/   745DC :                     ; Header - Set up Voice Location
(2)  274/   745DC :                     ; Common to music and SFX
(2)  275/   745DC :                     smpsHeaderVoice macro loc
(2)  276/   745DC :                     	if songStart<>*
(2)  277/   745DC :                     		fatal "Missing smpsHeaderStartSong"
(2)  278/   745DC :                     	endif
(2)  279/   745DC :                     	if SonicDriverVer<>1
(2)  280/   745DC :                     		dc.w	z80_ptr(loc)
(2)  281/   745DC :                     	else
(2)  282/   745DC :                     		if (MOMPASS=1)&&(DEFINED(loc))
(2)  283/   745DC :                     			fatal "Voice banks for Sonic 1 songs must come after the start of the song"
(2)  284/   745DC :                     		endif
(2)  285/   745DC :                     		dc.w	loc-songStart
(2)  286/   745DC :                     	endif
(2)  287/   745DC :                     	endm
(2)  288/   745DC :                     
(2)  289/   745DC :                     ; Header - Set up Voice Location as S3's Universal Voice Bank
(2)  290/   745DC :                     ; Common to music and SFX
(2)  291/   745DC :                     smpsHeaderVoiceUVB macro
(2)  292/   745DC :                     	if songStart<>*
(2)  293/   745DC :                     		fatal "Missing smpsHeaderStartSong"
(2)  294/   745DC :                     	endif
(2)  295/   745DC :                     	if SonicDriverVer>=5
(2)  296/   745DC :                     		dc.w	z80_ptr(z80_UniVoiceBank)
(2)  297/   745DC :                     	elseif SonicDriverVer>=3
(2)  298/   745DC :                     		dc.w	little_endian(z80_UniVoiceBank)
(2)  299/   745DC :                     	else
(2)  300/   745DC :                     		fatal "Universal Voice Bank does not exist in Sonic 1 or Sonic 2 drivers"
(2)  301/   745DC :                     	endif
(2)  302/   745DC :                     	endm
(2)  303/   745DC :                     
(2)  304/   745DC :                     ; Header macros for music (not for SFX)
(2)  305/   745DC :                     ; Header - Set up Channel Usage
(2)  306/   745DC :                     smpsHeaderChan macro fm,psg
(2)  307/   745DC :                     	dc.b	fm,psg
(2)  308/   745DC :                     	endm
(2)  309/   745DC :                     
(2)  310/   745DC :                     ; Header - Set up Tempo
(2)  311/   745DC :                     smpsHeaderTempo macro div,mod
(2)  312/   745DC :                     	dc.b	div
(2)  313/   745DC :                     	convertMainTempoMod mod
(2)  314/   745DC :                     	endm
(2)  315/   745DC :                     
(2)  316/   745DC :                     ; Header - Set up DAC Channel
(2)  317/   745DC :                     smpsHeaderDAC macro loc,pitch,vol
(2)  318/   745DC :                     	CheckedChannelPointer loc
(2)  319/   745DC :                     	if ("pitch"<>"")
(2)  320/   745DC :                     		dc.b	pitch
(2)  321/   745DC :                     		if ("vol"<>"")
(2)  322/   745DC :                     			dc.b	vol
(2)  323/   745DC :                     		else
(2)  324/   745DC :                     			dc.b	$00
(2)  325/   745DC :                     		endif
(2)  326/   745DC :                     	else
(2)  327/   745DC :                     		dc.w	$00
(2)  328/   745DC :                     	endif
(2)  329/   745DC :                     	endm
(2)  330/   745DC :                     
(2)  331/   745DC :                     ; Header - Set up FM Channel
(2)  332/   745DC :                     smpsHeaderFM macro loc,pitch,vol
(2)  333/   745DC :                     	CheckedChannelPointer loc
(2)  334/   745DC :                     	dc.b	pitch,vol
(2)  335/   745DC :                     	endm
(2)  336/   745DC :                     
(2)  337/   745DC :                     ; Header - Set up PSG Channel
(2)  338/   745DC :                     smpsHeaderPSG macro loc,pitch,vol,mod,voice
(2)  339/   745DC :                     	CheckedChannelPointer loc
(2)  340/   745DC :                     	PSGPitchConvert pitch
(2)  341/   745DC :                     	dc.b	vol
(2)  342/   745DC :                     	; Frequency envelope
(2)  343/   745DC :                     	if (SonicDriverVer>=3) && (SourceDriver<3)
(2)  344/   745DC :                     		; In SMPS 68k Type 1, this byte is skipped and can contain garbage.
(2)  345/   745DC :                     		; Sonic 2's Oil Ocean Zone and Ending themes set this byte to a non-zero value which
(2)  346/   745DC :                     		; other drivers may try to process as valid data, so manually force it to 0 here.
(2)  347/   745DC :                     		dc.b	0
(2)  348/   745DC :                     	else
(2)  349/   745DC :                     		if (MOMPASS==1) && (SonicDriverVer<3) && (SourceDriver>=3) && (mod<>0)
(2)  350/   745DC :                     			message "This track header specifies a frequency envelope, but this driver does not support them."
(2)  351/   745DC :                     		endif
(2)  352/   745DC :                     		dc.b	mod
(2)  353/   745DC :                     	endif
(2)  354/   745DC :                     	; Volume envelope
(2)  355/   745DC :                     	dc.b	voice
(2)  356/   745DC :                     	endm
(2)  357/   745DC :                     
(2)  358/   745DC :                     ; Header macros for SFX (not for music)
(2)  359/   745DC :                     ; Header - Set up Tempo
(2)  360/   745DC :                     smpsHeaderTempoSFX macro div
(2)  361/   745DC :                     	dc.b	div
(2)  362/   745DC :                     	endm
(2)  363/   745DC :                     
(2)  364/   745DC :                     ; Header - Set up Channel Usage
(2)  365/   745DC :                     smpsHeaderChanSFX macro chan
(2)  366/   745DC :                     	dc.b	chan
(2)  367/   745DC :                     	endm
(2)  368/   745DC :                     
(2)  369/   745DC :                     ; Header - Set up FM Channel
(2)  370/   745DC :                     smpsHeaderSFXChannel macro chanid,loc,pitch,vol
(2)  371/   745DC :                     	if (SonicDriverVer>=3)&&(chanid==cNoise)
(2)  372/   745DC :                     		fatal "Using channel ID of cNoise ($E0) in Sonic 3 driver is dangerous. Fix the song so that it turns into a noise channel instead."
(2)  373/   745DC :                     	elseif (SonicDriverVer<3)&&(chanid==cFM6)
(2)  374/   745DC :                     		fatal "Using channel ID of FM6 ($06) in Sonic 1 or Sonic 2 drivers is unsupported. Change it to another channel."
(2)  375/   745DC :                     	endif
(2)  376/   745DC :                     	dc.b	$80,chanid
(2)  377/   745DC :                     	CheckedChannelPointer loc
(2)  378/   745DC :                     	if (chanid&$80)<>0
(2)  379/   745DC :                     		PSGPitchConvert pitch
(2)  380/   745DC :                     	else
(2)  381/   745DC :                     		dc.b	pitch
(2)  382/   745DC :                     	endif
(2)  383/   745DC :                     	dc.b	vol
(2)  384/   745DC :                     	endm
(2)  385/   745DC :                     ; ---------------------------------------------------------------------------
(2)  386/   745DC :                     ; Co-ord Flag Macros and Equates
(2)  387/   745DC :                     ; E0xx - Panning, AMS, FMS
(2)  388/   745DC :                     smpsPan macro direction,amsfms
(2)  389/   745DC :                     panNone set $00
(2)  390/   745DC :                     panRight set $40
(2)  391/   745DC :                     panLeft set $80
(2)  392/   745DC :                     panCentre set $C0
(2)  393/   745DC :                     panCenter set $C0 ; silly Americans :U
(2)  394/   745DC :                     	dc.b $E0,direction+amsfms
(2)  395/   745DC :                     	endm
(2)  396/   745DC :                     
(2)  397/   745DC :                     ; E1xx - Set channel detune to val
(2)  398/   745DC :                     smpsDetune macro val
(2)  399/   745DC :                     	dc.b	$E1,val
(2)  400/   745DC :                     	endm
(2)  401/   745DC :                     
(2)  402/   745DC :                     ; E2xx - Used for setting a variable which can be read by the game, for synchonisation. Ristar does this.
(2)  403/   745DC :                     smpsNop macro val
(2)  404/   745DC :                     	if (SonicDriverVer>=3) && ((val==$FF) || (val==$29))
(2)  405/   745DC :                     		warning "Values $FF and $29 are reserved in S3K's driver; use a different value or remove this command."
(2)  406/   745DC :                     	endif
(2)  407/   745DC :                     	dc.b	$E2,val
(2)  408/   745DC :                     	endm
(2)  409/   745DC :                     
(2)  410/   745DC :                     ; Return (used after smpsCall)
(2)  411/   745DC :                     smpsReturn macro val
(2)  412/   745DC :                     	if SonicDriverVer>=3
(2)  413/   745DC :                     		dc.b	$F9
(2)  414/   745DC :                     	else
(2)  415/   745DC :                     		dc.b	$E3
(2)  416/   745DC :                     	endif
(2)  417/   745DC :                     	endm
(2)  418/   745DC :                     
(2)  419/   745DC :                     ; Fade in previous song (ie. 1-Up)
(2)  420/   745DC :                     smpsFade macro val
(2)  421/   745DC :                     	if SonicDriverVer>=3
(2)  422/   745DC :                     		dc.b	$E2
(2)  423/   745DC :                     		if ("val"<>"")
(2)  424/   745DC :                     			dc.b	val
(2)  425/   745DC :                     		else
(2)  426/   745DC :                     			dc.b	$FF
(2)  427/   745DC :                     		endif
(2)  428/   745DC :                     		if SourceDriver<3
(2)  429/   745DC :                     			smpsStop
(2)  430/   745DC :                     		endif
(2)  431/   745DC :                     	elseif (SourceDriver>=3) && ("val"<>"") && ("val"<>"$FF")
(2)  432/   745DC :                     		; This is actually a communication byte, not a fade.
(2)  433/   745DC :                     		smpsNop	val
(2)  434/   745DC :                     	else
(2)  435/   745DC :                     		dc.b	$E4
(2)  436/   745DC :                     	endif
(2)  437/   745DC :                     	endm
(2)  438/   745DC :                     
(2)  439/   745DC :                     ; E5xx - Set channel tempo divider to xx
(2)  440/   745DC :                     smpsChanTempoDiv macro val
(2)  441/   745DC :                     	if SonicDriverVer>=5
(2)  442/   745DC :                     		; New flag unique to Flamewing's modified S&K driver
(2)  443/   745DC :                     		dc.b	$FF,$08,val
(2)  444/   745DC :                     	elseif SonicDriverVer==3
(2)  445/   745DC :                     		fatal "Coord. Flag to set tempo divider of a single channel does not exist in S3 driver. Use Flamewing's modified S&K sound driver instead."
(2)  446/   745DC :                     	else
(2)  447/   745DC :                     		dc.b	$E5,val
(2)  448/   745DC :                     	endif
(2)  449/   745DC :                     	endm
(2)  450/   745DC :                     
(2)  451/   745DC :                     ; E6xx - Alter Volume by xx
(2)  452/   745DC :                     smpsAlterVol macro val
(2)  453/   745DC :                     	dc.b	$E6,val
(2)  454/   745DC :                     	endm
(2)  455/   745DC :                     
(2)  456/   745DC :                     ; E7 - Prevent attack of next note
(2)  457/   745DC : =$E7                 smpsNoAttack	EQU $E7
(2)  458/   745DC :                     
(2)  459/   745DC :                     ; E8xx - Set note fill to xx
(2)  460/   745DC :                     smpsNoteFill macro val
(2)  461/   745DC :                     	if (SonicDriverVer>=5)&&(SourceDriver<3)
(2)  462/   745DC :                     		; Unique to Flamewing's modified driver
(2)  463/   745DC :                     		dc.b	$FF,$0A,val
(2)  464/   745DC :                     	else
(2)  465/   745DC :                     		if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  466/   745DC :                     			message "Note fill will not work as intended unless you divide the fill value by the tempo divider or complain to Flamewing to add an appropriate coordination flag for it."
(2)  467/   745DC :                     		elseif (SonicDriverVer<3)&&(SourceDriver>=3)
(2)  468/   745DC :                     			message "Note fill will not work as intended unless you multiply the fill value by the tempo divider or complain to Flamewing to add an appropriate coordination flag for it."
(2)  469/   745DC :                     		endif
(2)  470/   745DC :                     		dc.b	$E8,val
(2)  471/   745DC :                     	endif
(2)  472/   745DC :                     	endm
(2)  473/   745DC :                     
(2)  474/   745DC :                     ; Add xx to channel pitch
(2)  475/   745DC :                     smpsChangeTransposition macro val
(2)  476/   745DC :                     	if SonicDriverVer>=3
(2)  477/   745DC :                     		dc.b	$FB,val
(2)  478/   745DC :                     	else
(2)  479/   745DC :                     		dc.b	$E9,val
(2)  480/   745DC :                     	endif
(2)  481/   745DC :                     	endm
(2)  482/   745DC :                     
(2)  483/   745DC :                     ; Set music tempo modifier to xx
(2)  484/   745DC :                     smpsSetTempoMod macro mod
(2)  485/   745DC :                     	if SonicDriverVer>=3
(2)  486/   745DC :                     		dc.b	$FF,$00
(2)  487/   745DC :                     	else
(2)  488/   745DC :                     		dc.b	$EA
(2)  489/   745DC :                     	endif
(2)  490/   745DC :                     	convertMainTempoMod mod
(2)  491/   745DC :                     	endm
(2)  492/   745DC :                     
(2)  493/   745DC :                     ; Set music tempo divider to xx
(2)  494/   745DC :                     smpsSetTempoDiv macro val
(2)  495/   745DC :                     	if SonicDriverVer>=3
(2)  496/   745DC :                     		dc.b	$FF,$04,val
(2)  497/   745DC :                     	else
(2)  498/   745DC :                     		dc.b	$EB,val
(2)  499/   745DC :                     	endif
(2)  500/   745DC :                     	endm
(2)  501/   745DC :                     
(2)  502/   745DC :                     ; ECxx - Set Volume to xx
(2)  503/   745DC :                     smpsSetVol macro val
(2)  504/   745DC :                     	if SonicDriverVer>=3
(2)  505/   745DC :                     		dc.b	$E4,val
(2)  506/   745DC :                     	else
(2)  507/   745DC :                     		fatal "Coord. Flag to set volume (instead of volume attenuation) does not exist in S1 or S2 drivers. Complain to Flamewing to add it."
(2)  508/   745DC :                     	endif
(2)  509/   745DC :                     	endm
(2)  510/   745DC :                     
(2)  511/   745DC :                     ; Works on all drivers
(2)  512/   745DC :                     smpsPSGAlterVol macro vol
(2)  513/   745DC :                     	dc.b	$EC,vol
(2)  514/   745DC :                     	endm
(2)  515/   745DC :                     
(2)  516/   745DC :                     smpsPSGAlterVolS2 macro vol
(2)  517/   745DC :                     	; Sonic 2's driver allows the FM command to be used on PSG channels, but others do not.
(2)  518/   745DC :                     	if SonicDriverVer==2
(2)  519/   745DC :                     		smpsAlterVol vol
(2)  520/   745DC :                     	else
(2)  521/   745DC :                     		smpsPSGAlterVol vol
(2)  522/   745DC :                     	endif
(2)  523/   745DC :                     	endm
(2)  524/   745DC :                     
(2)  525/   745DC :                     ; Clears pushing sound flag in S1
(2)  526/   745DC :                     smpsClearPush macro
(2)  527/   745DC :                     	if SonicDriverVer==1
(2)  528/   745DC :                     		dc.b	$ED
(2)  529/   745DC :                     	else
(2)  530/   745DC :                     		fatal "Coord. Flag to clear S1 push block flag does not exist in S2 or S3 drivers. Complain to Flamewing to add it."
(2)  531/   745DC :                     	endif
(2)  532/   745DC :                     	endm
(2)  533/   745DC :                     
(2)  534/   745DC :                     ; Stops special SFX (S1 only) and restarts overridden music track
(2)  535/   745DC :                     smpsStopSpecial macro
(2)  536/   745DC :                     	if SonicDriverVer==1
(2)  537/   745DC :                     		dc.b	$EE
(2)  538/   745DC :                     	else
(2)  539/   745DC :                     		message "Coord. Flag to stop special SFX does not exist in S2 or S3 drivers. Complain to Flamewing to add it. With adequate caution, smpsStop can do this job."
(2)  540/   745DC :                     		smpsStop
(2)  541/   745DC :                     	endif
(2)  542/   745DC :                     	endm
(2)  543/   745DC :                     
(2)  544/   745DC :                     ; EFxx[yy] - Set Voice of FM channel to xx; xx < 0 means yy present
(2)  545/   745DC :                     smpsFMvoice macro voice,songID
(2)  546/   745DC :                     	if (SonicDriverVer>=3)&&("songID"<>"")
(2)  547/   745DC :                     		dc.b	$EF,voice|$80,songID+$81
(2)  548/   745DC :                     	else
(2)  549/   745DC :                     		dc.b	$EF,voice
(2)  550/   745DC :                     	endif
(2)  551/   745DC :                     	endm
(2)  552/   745DC :                     
(2)  553/   745DC :                     ; F0wwxxyyzz - Modulation - ww: wait time - xx: modulation speed - yy: change per step - zz: number of steps
(2)  554/   745DC :                     smpsModSet macro wait,speed,change,step
(2)  555/   745DC :                     	dc.b	$F0
(2)  556/   745DC :                     	if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  557/   745DC :                     		dc.b	wait+1,speed,change,((step+1) * speed) & $FF
(2)  558/   745DC :                     	elseif (SonicDriverVer<3)&&(SourceDriver>=3)
(2)  559/   745DC :                     		dc.b	wait-1,speed,change,conv0To256(step)/conv0To256(speed)-1
(2)  560/   745DC :                     	else
(2)  561/   745DC :                     		dc.b	wait,speed,change,step
(2)  562/   745DC :                     	endif
(2)  563/   745DC :                     	;dc.b	speed,change,step
(2)  564/   745DC :                     	endm
(2)  565/   745DC :                     
(2)  566/   745DC :                     ; Turn on Modulation
(2)  567/   745DC :                     smpsModOn macro type
(2)  568/   745DC :                     	if SonicDriverVer>=3
(2)  569/   745DC :                     		if "type"<>""
(2)  570/   745DC :                     			dc.b	$F4,type
(2)  571/   745DC :                     		else
(2)  572/   745DC :                     			dc.b	$F4,$80
(2)  573/   745DC :                     		endif
(2)  574/   745DC :                     	else
(2)  575/   745DC :                     		dc.b	$F1
(2)  576/   745DC :                     	endif
(2)  577/   745DC :                     	endm
(2)  578/   745DC :                     
(2)  579/   745DC :                     ; F2 - End of channel
(2)  580/   745DC :                     smpsStop macro
(2)  581/   745DC :                     	dc.b	$F2
(2)  582/   745DC :                     	endm
(2)  583/   745DC :                     
(2)  584/   745DC :                     ; F3xx - PSG waveform to xx
(2)  585/   745DC :                     smpsPSGform macro form
(2)  586/   745DC :                     	dc.b	$F3,form
(2)  587/   745DC :                     	endm
(2)  588/   745DC :                     
(2)  589/   745DC :                     ; Turn off Modulation
(2)  590/   745DC :                     smpsModOff macro
(2)  591/   745DC :                     	if SonicDriverVer>=3
(2)  592/   745DC :                     		dc.b	$FA
(2)  593/   745DC :                     	else
(2)  594/   745DC :                     		dc.b	$F4
(2)  595/   745DC :                     	endif
(2)  596/   745DC :                     	endm
(2)  597/   745DC :                     
(2)  598/   745DC :                     ; F5xx - PSG voice to xx
(2)  599/   745DC :                     smpsPSGvoice macro voice
(2)  600/   745DC :                     	dc.b	$F5,voice
(2)  601/   745DC :                     	endm
(2)  602/   745DC :                     
(2)  603/   745DC :                     ; F6xxxx - Jump to xxxx
(2)  604/   745DC :                     smpsJump macro loc
(2)  605/   745DC :                     	dc.b	$F6
(2)  606/   745DC :                     	if SonicDriverVer<>1
(2)  607/   745DC :                     		dc.w	z80_ptr(loc)
(2)  608/   745DC :                     	else
(2)  609/   745DC :                     		dc.w	loc-*-1
(2)  610/   745DC :                     	endif
(2)  611/   745DC :                     	endm
(2)  612/   745DC :                     
(2)  613/   745DC :                     ; F7xxyyzzzz - Loop back to zzzz yy times, xx being the loop index for loop recursion fixing
(2)  614/   745DC :                     smpsLoop macro index,loops,loc
(2)  615/   745DC :                     	dc.b	$F7
(2)  616/   745DC :                     	dc.b	index,loops
(2)  617/   745DC :                     	if SonicDriverVer<>1
(2)  618/   745DC :                     		dc.w	z80_ptr(loc)
(2)  619/   745DC :                     	else
(2)  620/   745DC :                     		dc.w	loc-*-1
(2)  621/   745DC :                     	endif
(2)  622/   745DC :                     	endm
(2)  623/   745DC :                     
(2)  624/   745DC :                     ; F8xxxx - Call pattern at xxxx, saving return point
(2)  625/   745DC :                     smpsCall macro loc
(2)  626/   745DC :                     	dc.b	$F8
(2)  627/   745DC :                     	if SonicDriverVer<>1
(2)  628/   745DC :                     		dc.w	z80_ptr(loc)
(2)  629/   745DC :                     	else
(2)  630/   745DC :                     		dc.w	loc-*-1
(2)  631/   745DC :                     	endif
(2)  632/   745DC :                     	endm
(2)  633/   745DC :                     ; ---------------------------------------------------------------------------
(2)  634/   745DC :                     ; Alter Volume
(2)  635/   745DC :                     smpsFMAlterVol macro val1,val2
(2)  636/   745DC :                     	if ("val2"<>"")
(2)  637/   745DC :                     		; S3K's nerfed 'PSG & FM volume' command with broken PSG support.
(2)  638/   745DC :                     		; The first value is completely unused, while the second is for FM tracks.
(2)  639/   745DC :                     		if (SonicDriverVer>=3)
(2)  640/   745DC :                     			dc.b	$E5,val1,val2
(2)  641/   745DC :                     		else
(2)  642/   745DC :                     			dc.b	$E6,val2
(2)  643/   745DC :                     		endif
(2)  644/   745DC :                     	else
(2)  645/   745DC :                     		; Normal, sane command.
(2)  646/   745DC :                     		dc.b	$E6,val1
(2)  647/   745DC :                     	endif
(2)  648/   745DC :                     	endm
(2)  649/   745DC :                     
(2)  650/   745DC :                     ; S3/S&K/S3D-only coordination flags
