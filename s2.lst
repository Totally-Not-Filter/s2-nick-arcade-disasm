    2111/    2CB6 :                     ; Subroutine to calculate sine and cosine of an angle
    2112/    2CB6 :                     ; d0 = input byte = angle (360 degrees == 256)
    2113/    2CB6 :                     ; d0 = output word = 255 * sine(angle)
    2114/    2CB6 :                     ; d1 = output word = 255 * cosine(angle)
    2115/    2CB6 :                     ; ---------------------------------------------------------------------------
