     258/     2CA :                     Z80StartupCodeBegin:
     259/     2CA :                     	; Z80 instructions (not the sound driver; that gets loaded later)
     261/     2CA :                     	save
     262/     2CA :                     	CPU Z80 ; start assembling Z80 code
     263/       0 :                     	phase 0 ; pretend we're at address 0
     264/       0 : AF                  	xor	a	; clear a to 0
     265/       1 : 01 D9 1F            	ld	bc,((z80_ram_end-z80_ram)-zStartupCodeEndLoc)-1 ; prepare to loop this many times
     266/       4 : 11 27 00            	ld	de,zStartupCodeEndLoc+1	; initial destination address
     267/       7 : 21 26 00            	ld	hl,zStartupCodeEndLoc	; initial source address
     268/       A : F9                  	ld	sp,hl	; set the address the stack starts at
     269/       B : 77                  	ld	(hl),a	; set first byte of the stack to 0
     270/       C : ED B0               	ldir		; loop to fill the stack (entire remaining available Z80 RAM) with 0
     271/       E : DD E1               	pop	ix	; clear ix
     272/      10 : FD E1               	pop	iy	; clear iy
     273/      12 : ED 47               	ld	i,a	; clear i
     274/      14 : ED 4F               	ld	r,a	; clear r
     275/      16 : D1                  	pop	de	; clear de
     276/      17 : E1                  	pop	hl	; clear hl
     277/      18 : F1                  	pop	af	; clear af
     278/      19 : 08                  	ex	af,af'	; swap af with af'
     279/      1A : D9                  	exx		; swap bc/de/hl with their shadow registers too
     280/      1B : C1                  	pop	bc	; clear bc
     281/      1C : D1                  	pop	de	; clear de
     282/      1D : E1                  	pop	hl	; clear hl
     283/      1E : F1                  	pop	af	; clear af
     284/      1F : F9                  	ld	sp,hl	; clear sp
     285/      20 : F3                  	di		; clear iff1 (for interrupt handler)
     286/      21 : ED 56               	im	1	; interrupt handling mode = 1
     287/      23 : 36 E9               	ld	(hl),0E9h ; replace the first instruction with a jump to itself
     288/      25 : E9                  	jp	(hl)	  ; jump to the first instruction (to stay there forever)
     289/      26 :                     zStartupCodeEndLoc:
     290/     2F0 :                     	dephase ; stop pretending
     291/     2F0 : ALL                  	restore
     292/     2F0 :                     	padding off ; unfortunately our flags got reset so we have to set them again...
