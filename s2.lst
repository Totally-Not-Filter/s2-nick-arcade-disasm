(2)  218/      E0 : 70 07                       dw      zDAC_Snare.size                              ; Length
(2)  218/      E2 : 01 00                       dw      dpcmLoopCounter(zDAC_Snare.sample_rate)      ; Pitch
(2)  218/      E4 : 00 00                       dw      0                                       ; Padding
(2)  219/      E6 : =0EAH                zTimpani_Pitch = $+4
