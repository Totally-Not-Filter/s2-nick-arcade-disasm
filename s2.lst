   13465/   1BFEC :                     
   13466/   1BFEC :                     		include	"_Include/LevelHeaders.asm"
(1)    1/   1BFEC :                     ; ---------------------------------------------------------------------------
(1)    2/   1BFEC :                     ; "MAIN LEVEL LOAD BLOCK" (after Nemesis)
(1)    3/   1BFEC :                     ;
(1)    4/   1BFEC :                     ; This struct array tells the engine where to find all the art associated with
(1)    5/   1BFEC :                     ; a particular zone. Each zone gets four longwords, in which it stores four
(1)    6/   1BFEC :                     ; pointers (in the lower 24 bits) and three jump table indeces (in the upper eight
(1)    7/   1BFEC :                     ; bits). The assembled data looks something like this:
(1)    8/   1BFEC :                     ;
(1)    9/   1BFEC :                     ; aaBBBBBB
(1)   10/   1BFEC :                     ; ccDDDDDD
(1)   11/   1BFEC :                     ; EEEEEE
(1)   12/   1BFEC :                     ; ffgghhii
(1)   13/   1BFEC :                     ;
(1)   14/   1BFEC :                     ; aa = index for primary pattern load request list
(1)   15/   1BFEC :                     ; BBBBBB = unused, pointer to level art
(1)   16/   1BFEC :                     ; cc = index for secondary pattern load request list
(1)   17/   1BFEC :                     ; DDDDDD = pointer to 16x16 block mappings
(1)   18/   1BFEC :                     ; EEEEEE = pointer to 128x128 block mappings
(1)   19/   1BFEC :                     ; ff = unused, always 0
(1)   20/   1BFEC :                     ; gg = unused, music track
(1)   21/   1BFEC :                     ; hh = unused, palette
(1)   22/   1BFEC :                     ; ii = palette
(1)   23/   1BFEC :                     ;
(1)   24/   1BFEC :                     ; Nemesis refers to this as the "main level load block". However, that name implies
(1)   25/   1BFEC :                     ; that this is code (obviously, it isn't), or at least that it points to the level's
(1)   26/   1BFEC :                     ; collision, object and ring placement arrays (it only points to palettes and 16x16
(1)   27/   1BFEC :                     ; mappings although the 128x128 mappings do affect the actual level layout and collision)
(1)   28/   1BFEC :                     ; ---------------------------------------------------------------------------
(1)   29/   1BFEC :                     
(1)   30/   1BFEC :                     ; macro for declaring a "main level load block" (MLLB)
(1)   31/   1BFEC :                     levartptrs macro plc1,plc2,art,map16x16,map128x128,music,palette
(1)   32/   1BFEC :                     	dc.l (plc1<<24)|art
(1)   33/   1BFEC :                     	dc.l (plc2<<24)|map16x16
(1)   34/   1BFEC :                     	dc.l map128x128
(1)   35/   1BFEC :                     	dc.b 0,music,palette,palette
(1)   36/   1BFEC :                     	endm
(1)   37/   1BFEC :                     
(1)   38/   1BFEC :                     ; MainLoadBlocks:
(1)   39/   1BFEC :                     LevelArtPointers:
(1)   40/   1BFEC : (MACRO)              		levartptrs plcid_GHZ, plcid_GHZ2, Nem_GHZ, Map16_GHZ, Map128_GHZ, bgm_GHZ, palid_GHZ ; GHZ  ; GREEN HILL ZONE
(1)   40/   1BFEC : 040D 8C34                   dc.l (plcid_GHZ<<24)|Nem_GHZ
(1)   40/   1BFF0 : 050D 7E34                   dc.l (plcid_GHZ2<<24)|Map16_GHZ
(1)   40/   1BFF4 : 000D D850                   dc.l Map128_GHZ
(1)   40/   1BFF8 : 0081 0404                   dc.b 0,bgm_GHZ,palid_GHZ,palid_GHZ
(1)   41/   1BFFC : (MACRO)              		levartptrs plcid_LZ, plcid_LZ2, Nem_CPZ, Map16_CPZ, Map128_CPZ, bgm_LZ, palid_LZ ; LZ   ; LABYRINTH ZONE
(1)   41/   1BFFC : 060C C8F4                   dc.l (plcid_LZ<<24)|Nem_CPZ
(1)   41/   1C000 : 070C B314                   dc.l (plcid_LZ2<<24)|Map16_CPZ
(1)   41/   1C004 : 000C FE34                   dc.l Map128_CPZ
(1)   41/   1C008 : 0082 0505                   dc.b 0,bgm_LZ,palid_LZ,palid_LZ
(1)   42/   1C00C : (MACRO)              		levartptrs plcid_CPZ, plcid_CPZ2, Nem_CPZ, Map16_CPZ, Map128_CPZ, bgm_MZ, palid_CPZ ; CPZ  ; CHEMICAL PLANT ZONE
(1)   42/   1C00C : 080C C8F4                   dc.l (plcid_CPZ<<24)|Nem_CPZ
(1)   42/   1C010 : 090C B314                   dc.l (plcid_CPZ2<<24)|Map16_CPZ
(1)   42/   1C014 : 000C FE34                   dc.l Map128_CPZ
(1)   42/   1C018 : 0083 0606                   dc.b 0,bgm_MZ,palid_CPZ,palid_CPZ
(1)   43/   1C01C : (MACRO)              		levartptrs plcid_EHZ, plcid_EHZ2, Nem_EHZ, Map16_EHZ, Map128_EHZ, bgm_SLZ, palid_EHZ ; EHZ  ; EMERALD HILL ZONE
(1)   43/   1C01C : 0A0B 2184                   dc.l (plcid_EHZ<<24)|Nem_EHZ
(1)   43/   1C020 : 0B0B 11E4                   dc.l (plcid_EHZ2<<24)|Map16_EHZ
(1)   43/   1C024 : 000B 6EB2                   dc.l Map128_EHZ
(1)   43/   1C028 : 0084 0707                   dc.b 0,bgm_SLZ,palid_EHZ,palid_EHZ
(1)   44/   1C02C : (MACRO)              		levartptrs plcid_HPZ, plcid_HPZ2, Nem_HPZ, Map16_HPZ, Map128_HPZ, bgm_SYZ, palid_HPZ ; HPZ  ; HIDDEN PALACE ZONE
(1)   44/   1C02C : 0C0C 0492                   dc.l (plcid_HPZ<<24)|Nem_HPZ
(1)   44/   1C030 : 0D0B EEB2                   dc.l (plcid_HPZ2<<24)|Map16_HPZ
(1)   44/   1C034 : 000C 3314                   dc.l Map128_HPZ
(1)   44/   1C038 : 0085 0808                   dc.b 0,bgm_SYZ,palid_HPZ,palid_HPZ
(1)   45/   1C03C : (MACRO)              		levartptrs plcid_HTZ, plcid_HTZ2, Nem_EHZ, Map16_EHZ, Map128_EHZ, bgm_SBZ, palid_HTZ1 ; HTZ  ; HILL TOP ZONE
(1)   45/   1C03C : 0E0B 2184                   dc.l (plcid_HTZ<<24)|Nem_EHZ
(1)   45/   1C040 : 0F0B 11E4                   dc.l (plcid_HTZ2<<24)|Map16_EHZ
(1)   45/   1C044 : 000B 6EB2                   dc.l Map128_EHZ
(1)   45/   1C048 : 0086 0909                   dc.b 0,bgm_SBZ,palid_HTZ1,palid_HTZ1
(1)   46/   1C04C : (MACRO)              		levartptrs 0, 0, Nem_GHZ, Map16_GHZ, Map128_GHZ, bgm_SBZ, palid_Ending ; LEV6 ; LEVEL 6 (UNUSED, SONIC 1 ENDING)
(1)   46/   1C04C : 000D 8C34                   dc.l (0<<24)|Nem_GHZ
(1)   46/   1C050 : 000D 7E34                   dc.l (0<<24)|Map16_GHZ
(1)   46/   1C054 : 000D D850                   dc.l Map128_GHZ
(1)   46/   1C058 : 0086 1313                   dc.b 0,bgm_SBZ,palid_Ending,palid_Ending
   13467/   1C05C :                     		include	"_Include/Pattern Load Cues.asm"
(1)    1/   1C05C :                     ; ---------------------------------------------------------------------------
(1)    2/   1C05C :                     ; PATTERN LOAD REQUEST LISTS
(1)    3/   1C05C :                     ;
(1)    4/   1C05C :                     ; Pattern load request lists are simple structures used to load
(1)    5/   1C05C :                     ; Nemesis-compressed art for sprites.
(1)    6/   1C05C :                     ;
(1)    7/   1C05C :                     ; The decompressor predictably moves down the list, so request 0 is processed first, etc.
(1)    8/   1C05C :                     ; This only matters if your addresses are bad and you overwrite art loaded in a previous request.
(1)    9/   1C05C :                     ;
(1)   10/   1C05C :                     
(1)   11/   1C05C :                     ; NOTICE: The load queue buffer can only hold $10 (16) load requests. None of the routines
(1)   12/   1C05C :                     ; that load PLRs into the queue do any bounds checking, so it's possible to create a buffer
(1)   13/   1C05C :                     ; overflow and completely screw up the variables stored directly after the queue buffer.
(1)   14/   1C05C :                     ; (in my experience this is a guaranteed crash or hang)
(1)   15/   1C05C :                     ;
(1)   16/   1C05C :                     ; Many levels queue more than 16 items overall, but they don't exceed the limit because
(1)   17/   1C05C :                     ; their PLRs are split into multiple parts (like PLC_GHZ and PLC_GHZ2) and they fully
(1)   18/   1C05C :                     ; process the first part before requesting the rest.
(1)   19/   1C05C :                     ; ---------------------------------------------------------------------------
(1)   20/   1C05C :                     
(1)   21/   1C05C :                     ;---------------------------------------------------------------------------------------
(1)   22/   1C05C :                     ; Table of pattern load request lists. Remember to use word-length data when adding lists
(1)   23/   1C05C :                     ; otherwise you'll break the array.
(1)   24/   1C05C :                     ;---------------------------------------------------------------------------------------
(1)   25/   1C05C :                     ArtLoadCues:
(1)   26/   1C05C :                     
(1)   27/   1C05C : 0040                ptr_PLC_Main:		dc.w PLC_Main-ArtLoadCues
(1)   28/   1C05E : 0060                ptr_PLC_Main2:		dc.w PLC_Main2-ArtLoadCues
(1)   29/   1C060 : 0074                ptr_PLC_Explode:	dc.w PLC_Explode-ArtLoadCues
(1)   30/   1C062 : 007C                ptr_PLC_GameOver:	dc.w PLC_GameOver-ArtLoadCues
(1)   31/   1C064 :                     PLC_Levels:
(1)   32/   1C064 : 0084                ptr_PLC_GHZ:		dc.w PLC_GHZ-ArtLoadCues
