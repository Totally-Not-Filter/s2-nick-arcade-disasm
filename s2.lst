(2)  789/   745DC :                     ; Macros for FM instruments
(2)  790/   745DC :                     ; Voices - Feedback
(2)  791/   745DC :                     smpsVcFeedback macro val
(2)  792/   745DC :                     vcFeedback eval val
(2)  793/   745DC :                     	endm
(2)  794/   745DC :                     
(2)  795/   745DC :                     ; Voices - Algorithm
(2)  796/   745DC :                     smpsVcAlgorithm macro val
(2)  797/   745DC :                     vcAlgorithm eval val
(2)  798/   745DC :                     	endm
(2)  799/   745DC :                     
(2)  800/   745DC :                     smpsVcUnusedBits macro val,d1r1,d1r2,d1r3,d1r4
(2)  801/   745DC :                     vcUnusedBits eval val
(2)  802/   745DC :                     	if ("d1r1"<>"")&&("d1r2"<>"")&&("d1r3"<>"")&&("d1r4"<>"")
(2)  803/   745DC :                     		eval vcD1R1Unk,d1r1<<5
(2)  804/   745DC :                     		eval vcD1R2Unk,d1r2<<5
(2)  805/   745DC :                     		eval vcD1R3Unk,d1r3<<5
(2)  806/   745DC :                     		eval vcD1R4Unk,d1r4<<5
(2)  807/   745DC :                     	else
(2)  808/   745DC :                     		eval vcD1R1Unk,0
(2)  809/   745DC :                     		eval vcD1R2Unk,0
(2)  810/   745DC :                     		eval vcD1R3Unk,0
(2)  811/   745DC :                     		eval vcD1R4Unk,0
(2)  812/   745DC :                     	endif
(2)  813/   745DC :                     	endm
(2)  814/   745DC :                     
(2)  815/   745DC :                     ; Voices - Detune
(2)  816/   745DC :                     smpsVcDetune macro op1,op2,op3,op4
(2)  817/   745DC :                     	eval vcDT1,op1
(2)  818/   745DC :                     	eval vcDT2,op2
(2)  819/   745DC :                     	eval vcDT3,op3
(2)  820/   745DC :                     	eval vcDT4,op4
(2)  821/   745DC :                     	endm
(2)  822/   745DC :                     
(2)  823/   745DC :                     ; Voices - Coarse-Frequency
(2)  824/   745DC :                     smpsVcCoarseFreq macro op1,op2,op3,op4
(2)  825/   745DC :                     	eval vcCF1,op1
(2)  826/   745DC :                     	eval vcCF2,op2
(2)  827/   745DC :                     	eval vcCF3,op3
(2)  828/   745DC :                     	eval vcCF4,op4
(2)  829/   745DC :                     	endm
(2)  830/   745DC :                     
(2)  831/   745DC :                     ; Voices - Rate Scale
(2)  832/   745DC :                     smpsVcRateScale macro op1,op2,op3,op4
(2)  833/   745DC :                     	eval vcRS1,op1
(2)  834/   745DC :                     	eval vcRS2,op2
(2)  835/   745DC :                     	eval vcRS3,op3
(2)  836/   745DC :                     	eval vcRS4,op4
(2)  837/   745DC :                     	endm
(2)  838/   745DC :                     
(2)  839/   745DC :                     ; Voices - Attack Rate
(2)  840/   745DC :                     smpsVcAttackRate macro op1,op2,op3,op4
(2)  841/   745DC :                     	eval vcAR1,op1
(2)  842/   745DC :                     	eval vcAR2,op2
(2)  843/   745DC :                     	eval vcAR3,op3
(2)  844/   745DC :                     	eval vcAR4,op4
(2)  845/   745DC :                     	endm
(2)  846/   745DC :                     
(2)  847/   745DC :                     ; Voices - Amplitude Modulation
(2)  848/   745DC :                     ; The original SMPS2ASM erroneously assumed the 6th and 7th bits
(2)  849/   745DC :                     ; were the Amplitude Modulation.
(2)  850/   745DC :                     ; According to several docs, however, it's actually the high bit.
(2)  851/   745DC :                     smpsVcAmpMod macro op1,op2,op3,op4
(2)  852/   745DC :                     	if SourceSMPS2ASM==0
(2)  853/   745DC :                     		eval vcAM1,op1<<5
(2)  854/   745DC :                     		eval vcAM2,op2<<5
(2)  855/   745DC :                     		eval vcAM3,op3<<5
(2)  856/   745DC :                     		eval vcAM4,op4<<5
(2)  857/   745DC :                     	else
(2)  858/   745DC :                     		eval vcAM1,op1<<7
(2)  859/   745DC :                     		eval vcAM2,op2<<7
(2)  860/   745DC :                     		eval vcAM3,op3<<7
(2)  861/   745DC :                     		eval vcAM4,op4<<7
(2)  862/   745DC :                     	endif
(2)  863/   745DC :                     	endm
(2)  864/   745DC :                     
(2)  865/   745DC :                     ; Voices - First Decay Rate
(2)  866/   745DC :                     smpsVcDecayRate1 macro op1,op2,op3,op4
(2)  867/   745DC :                     	eval vcD1R1,op1
(2)  868/   745DC :                     	eval vcD1R2,op2
(2)  869/   745DC :                     	eval vcD1R3,op3
(2)  870/   745DC :                     	eval vcD1R4,op4
(2)  871/   745DC :                     	endm
(2)  872/   745DC :                     
(2)  873/   745DC :                     ; Voices - Second Decay Rate
(2)  874/   745DC :                     smpsVcDecayRate2 macro op1,op2,op3,op4
(2)  875/   745DC :                     	eval vcD2R1,op1
(2)  876/   745DC :                     	eval vcD2R2,op2
(2)  877/   745DC :                     	eval vcD2R3,op3
(2)  878/   745DC :                     	eval vcD2R4,op4
(2)  879/   745DC :                     	endm
(2)  880/   745DC :                     
(2)  881/   745DC :                     ; Voices - Decay Level
(2)  882/   745DC :                     smpsVcDecayLevel macro op1,op2,op3,op4
(2)  883/   745DC :                     	eval vcDL1,op1
(2)  884/   745DC :                     	eval vcDL2,op2
(2)  885/   745DC :                     	eval vcDL3,op3
(2)  886/   745DC :                     	eval vcDL4,op4
(2)  887/   745DC :                     	endm
(2)  888/   745DC :                     
(2)  889/   745DC :                     ; Voices - Release Rate
(2)  890/   745DC :                     smpsVcReleaseRate macro op1,op2,op3,op4
(2)  891/   745DC :                     	eval vcRR1,op1
(2)  892/   745DC :                     	eval vcRR2,op2
(2)  893/   745DC :                     	eval vcRR3,op3
(2)  894/   745DC :                     	eval vcRR4,op4
(2)  895/   745DC :                     	endm
(2)  896/   745DC :                     
(2)  897/   745DC :                     smpsNotZ80 function cpu,(cpu<>128)&&(cpu<>32988)
(2)  898/   745DC :                     
(2)  899/   745DC :                     smpsDcb macro
(2)  900/   745DC :                     		if smpsNotZ80(MOMCPU)
(2)  901/   745DC :                     			dc.b ALLARGS
(2)  902/   745DC :                     		else
(2)  903/   745DC :                     			db ALLARGS
(2)  904/   745DC :                     		endif
(2)  905/   745DC :                     	endm
(2)  906/   745DC :                     
(2)  907/   745DC :                     ; Voices - Total Level
(2)  908/   745DC :                     ; The original SMPS2ASM decides TL high bits automatically,
(2)  909/   745DC :                     ; but later versions leave it up to the user.
(2)  910/   745DC :                     ; Alternatively, if we're converting an SMPS 68k song to SMPS Z80,
(2)  911/   745DC :                     ; then we *want* the TL bits to match the algorithm, because SMPS 68k
(2)  912/   745DC :                     ; prefers the algorithm over the TL bits, ignoring the latter, while
(2)  913/   745DC :                     ; SMPS Z80 does the opposite.
(2)  914/   745DC :                     ; Unfortunately, there's nothing we can do if we're trying to convert
(2)  915/   745DC :                     ; an SMPS Z80 song to SMPS 68k. It will ignore the bits no matter
(2)  916/   745DC :                     ; what we do, so we just print a warning.
(2)  917/   745DC :                     smpsVcTotalLevel macro op1,op2,op3,op4
(2)  918/   745DC :                     	eval vcTL1,op1
(2)  919/   745DC :                     	eval vcTL2,op2
(2)  920/   745DC :                     	eval vcTL3,op3
(2)  921/   745DC :                     	eval vcTL4,op4
(2)  922/   745DC :                     	smpsDcb	(vcUnusedBits<<6)+(vcFeedback<<3)+vcAlgorithm
(2)  923/   745DC :                     ;   0     1     2     3     4     5     6     7
(2)  924/   745DC :                     ;%1000,%1000,%1000,%1000,%1010,%1110,%1110,%1111
(2)  925/   745DC :                     	if SourceSMPS2ASM==0
(2)  926/   745DC :                     		eval vcTLMask4,((vcAlgorithm==7)<<7)
(2)  927/   745DC :                     		eval vcTLMask3,((vcAlgorithm>=4)<<7)
(2)  928/   745DC :                     		eval vcTLMask2,((vcAlgorithm>=5)<<7)
(2)  929/   745DC :                     		eval vcTLMask1,128
(2)  930/   745DC :                     	else
(2)  931/   745DC :                     		eval vcTLMask4,0
(2)  932/   745DC :                     		eval vcTLMask3,0
(2)  933/   745DC :                     		eval vcTLMask2,0
(2)  934/   745DC :                     		eval vcTLMask1,0
(2)  935/   745DC :                     	endif
(2)  936/   745DC :                     
(2)  937/   745DC :                     	if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  938/   745DC :                     		eval vcTLMask4,((vcAlgorithm==7)<<7)
(2)  939/   745DC :                     		eval vcTLMask3,((vcAlgorithm>=4)<<7)
(2)  940/   745DC :                     		eval vcTLMask2,((vcAlgorithm>=5)<<7)
(2)  941/   745DC :                     		eval vcTLMask1,128
(2)  942/   745DC :                     		eval vcTL1,vcTL1&127
(2)  943/   745DC :                     		eval vcTL2,vcTL2&127
(2)  944/   745DC :                     		eval vcTL3,vcTL3&127
(2)  945/   745DC :                     		eval vcTL4,vcTL4&127
(2)  946/   745DC :                     	elseif (SonicDriverVer<3)&&(SourceDriver>=3)&&((((vcTL1|vcTLMask1)&128)<>128)||(((vcTL2|vcTLMask2)&128)<>((vcAlgorithm>=5)<<7))||(((vcTL3|vcTLMask3)&128)<>((vcAlgorithm>=4)<<7))||(((vcTL4|vcTLMask4)&128)<>((vcAlgorithm==7)<<7)))
(2)  947/   745DC :                     		if MOMPASS=1
(2)  948/   745DC :                     			message "Voice at 0x\{*} has TL bits that do not match its algorithm setting. This voice will not work in S1/S2 drivers."
(2)  949/   745DC :                     		endif
(2)  950/   745DC :                     	endif
(2)  951/   745DC :                     
(2)  952/   745DC :                     	if SonicDriverVer==2
(2)  953/   745DC :                     		smpsDcb	(vcDT4<<4)+vcCF4       ,(vcDT2<<4)+vcCF2       ,(vcDT3<<4)+vcCF3       ,(vcDT1<<4)+vcCF1
(2)  954/   745DC :                     		smpsDcb	(vcRS4<<6)+vcAR4       ,(vcRS2<<6)+vcAR2       ,(vcRS3<<6)+vcAR3       ,(vcRS1<<6)+vcAR1
(2)  955/   745DC :                     		smpsDcb	vcAM4|vcD1R4|vcD1R4Unk ,vcAM2|vcD1R2|vcD1R2Unk ,vcAM3|vcD1R3|vcD1R3Unk ,vcAM1|vcD1R1|vcD1R1Unk
(2)  956/   745DC :                     		smpsDcb	vcD2R4                 ,vcD2R2                 ,vcD2R3                 ,vcD2R1
(2)  957/   745DC :                     		smpsDcb	(vcDL4<<4)+vcRR4       ,(vcDL2<<4)+vcRR2       ,(vcDL3<<4)+vcRR3       ,(vcDL1<<4)+vcRR1
(2)  958/   745DC :                     		smpsDcb	vcTL4|vcTLMask4        ,vcTL2|vcTLMask2        ,vcTL3|vcTLMask3        ,vcTL1|vcTLMask1
(2)  959/   745DC :                     	else
(2)  960/   745DC :                     		smpsDcb	(vcDT4<<4)+vcCF4       ,(vcDT3<<4)+vcCF3       ,(vcDT2<<4)+vcCF2       ,(vcDT1<<4)+vcCF1
(2)  961/   745DC :                     		smpsDcb	(vcRS4<<6)+vcAR4       ,(vcRS3<<6)+vcAR3       ,(vcRS2<<6)+vcAR2       ,(vcRS1<<6)+vcAR1
(2)  962/   745DC :                     		smpsDcb	vcAM4|vcD1R4|vcD1R4Unk ,vcAM3|vcD1R3|vcD1R3Unk ,vcAM2|vcD1R2|vcD1R2Unk ,vcAM1|vcD1R1|vcD1R1Unk
(2)  963/   745DC :                     		smpsDcb	vcD2R4                 ,vcD2R3                 ,vcD2R2                 ,vcD2R1
(2)  964/   745DC :                     		smpsDcb	(vcDL4<<4)+vcRR4       ,(vcDL3<<4)+vcRR3       ,(vcDL2<<4)+vcRR2       ,(vcDL1<<4)+vcRR1
(2)  965/   745DC :                     		smpsDcb	vcTL4|vcTLMask4        ,vcTL3|vcTLMask3        ,vcTL2|vcTLMask2        ,vcTL1|vcTLMask1
(2)  966/   745DC :                     	endif
(2)  967/   745DC :                     	endm
(2)  968/   745DC :                     
(2)  969/   745DC :                     
