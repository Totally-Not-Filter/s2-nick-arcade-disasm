    6543/    CB34 :                     ; ObjectsLoad:
    6544/    CB34 :                     ExecuteObjects:
    6545/    CB34 : 41F8 B000           		lea	(v_objspace).w,a0
    6546/    CB38 : 7E7F                		moveq	#bytesToXcnt(v_objend-v_objspace,object_size),d7	; run the first $80 objects out of levels
    6547/    CB3A : 7000                		moveq	#0,d0
    6548/    CB3C : 0C38 0006 B024      		cmpi.b	#6,(v_player+obRoutine).w	; is Sonic dead?
    6549/    CB42 : 641A                		bhs.s	ExecuteObjectsWhenPlayerIsDead	; if yes, branch
    6550/    CB44 :                     
    6551/    CB44 :                     ; ---------------------------------------------------------------------------
    6552/    CB44 :                     ; This is THE place where each individual object's code gets called from
    6553/    CB44 :                     ; ---------------------------------------------------------------------------
    6554/    CB44 :                     
    6555/    CB44 :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
