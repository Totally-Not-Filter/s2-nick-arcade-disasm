    2076/    2C90 :                     ; Subroutine to generate a pseudo-random number in d0
    2077/    2C90 :                     ; d0 = (RNG & $FFFF0000) | ((RNG*41 & $FFFF) + ((RNG*41 & $FFFF0000) >> 16))
    2078/    2C90 :                     ; RNG = ((RNG*41 + ((RNG*41 & $FFFF) << 16)) & $FFFF0000) | (RNG*41 & $FFFF)
    2079/    2C90 :                     ; ---------------------------------------------------------------------------
    2080/    2C90 :                     
    2081/    2C90 :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
