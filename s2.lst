   12978/   1AC1E : 0C38 0002 FE10      		cmpi.b	#id_CPZ,(Current_Zone).w	; is this Chemical Plant Zone?
   12979/   1AC24 : 6702                		beq.s	loc_1AC28			; if yes, branch
   12980/   1AC26 :                     
   12981/   1AC26 :                     locret_1AC26:
   12982/   1AC26 : 4E75                		rts
   12983/   1AC28 :                     ; ===========================================================================
   12984/   1AC28 :                     ; this shifts all blocks of the chunks $EA-$ED and $FA-$FD one block to the
   12985/   1AC28 :                     ; left and the last block in each row (chunk $ED/$FD) to the beginning
   12986/   1AC28 :                     ; i.e. rotates the blocks to the left by one
   12987/   1AC28 :                     
   12988/   1AC28 :                     loc_1AC28:
   12989/   1AC28 : 3038 EE00           		move.w	(Camera_X_pos).w,d0
   12990/   1AC2C : 0C40 1940           		cmpi.w	#$1940,d0
