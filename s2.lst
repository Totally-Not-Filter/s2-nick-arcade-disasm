(1) 2848/   79688 :                     		; Don't let Sega sample cross $8000-byte boundary
(1) 2849/   79688 :                     		; (DAC driver doesn't switch banks automatically)
(1) 2853/   79688 :                     SegaPCM:	include "sound/dac/pcm/generated/sega.inc"
