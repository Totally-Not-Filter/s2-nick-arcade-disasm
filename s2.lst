    2089/    2C9C :                     loc_2C9C:
    2090/    2C9C :                     		; set the high word of d0 to be the high word of the RNG
    2091/    2C9C :                     		; and multiply the RNG by 41
    2092/    2C9C : 2001                		move.l	d1,d0
    2093/    2C9E : E581                		asl.l	#2,d1
    2094/    2CA0 : D280                		add.l	d0,d1
    2095/    2CA2 : E781                		asl.l	#3,d1
    2096/    2CA4 : D280                		add.l	d0,d1
    2097/    2CA6 :                     
    2098/    2CA6 :                     		; add the low word of the RNG to the high word of the RNG
    2099/    2CA6 :                     		; and set the low word of d0 to be the result
    2100/    2CA6 : 3001                		move.w	d1,d0
    2101/    2CA8 : 4841                		swap	d1
    2102/    2CAA : D041                		add.w	d1,d0
    2103/    2CAC : 3200                		move.w	d0,d1
    2104/    2CAE : 4841                		swap	d1
