   12730/   1AA96 : 00AC                		dc.w AnimCue_EHZ-DynArtCue_Index		; HTZ
   12731/   1AA98 : 0040                		dc.w Dynamic_Null-DynArtCue_Index		; 06
   12732/   1AA9A : 0136                		dc.w AnimCue_CPZ_Boss-DynArtCue_Index	; 06
   12733/   1AA9C : 0040                		dc.w Dynamic_Null-DynArtCue_Index		; 07
