   16666/   71990 :                     ; ---------------------------------------------------------------------------
   16667/   71990 :                     ; Modified Type 1b 68000 Sound Driver
   16668/   71990 :                     ; Same as Sonic 1's, down to its location in the ROM
   16669/   71990 :                     ; ---------------------------------------------------------------------------
   16670/   71990 :                     		include	"s1.sounddriver.asm"
(1)    1/   71990 :                     ; ---------------------------------------------------------------------------
(1)    2/   71990 :                     ; Modified SMPS 68k Type 1b sound driver
(1)    3/   71990 :                     ; The source code to a similar version of the driver can be found here:
(1)    4/   71990 :                     ; https://hiddenpalace.org/News/Sega_of_Japan_Sound_Documents_and_Source_Code
(1)    5/   71990 :                     ; ---------------------------------------------------------------------------
(1)    6/   71990 :                     
(1)    7/   71990 :                     ; Constants
(1)    8/   71990 : =$12                 SMPS_TRACK_COUNT = (SMPS_RAM.v_track_ram_end-SMPS_RAM.v_track_ram)/SMPS_Track.len
(1)    9/   71990 : =$A                  SMPS_MUSIC_TRACK_COUNT = (SMPS_RAM.v_music_track_ram_end-SMPS_RAM.v_music_track_ram)/SMPS_Track.len
(1)   10/   71990 : =$7                  SMPS_MUSIC_FM_DAC_TRACK_COUNT = (SMPS_RAM.v_music_fmdac_tracks_end-SMPS_RAM.v_music_fmdac_tracks)/SMPS_Track.len
(1)   11/   71990 : =$6                  SMPS_MUSIC_FM_TRACK_COUNT = (SMPS_RAM.v_music_fm_tracks_end-SMPS_RAM.v_music_fm_tracks)/SMPS_Track.len
(1)   12/   71990 : =$3                  SMPS_MUSIC_PSG_TRACK_COUNT = (SMPS_RAM.v_music_psg_tracks_end-SMPS_RAM.v_music_psg_tracks)/SMPS_Track.len
