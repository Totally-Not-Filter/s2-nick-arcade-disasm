(2)  771/   745DC :                     	endm
(2)  772/   745DC :                     
(2)  773/   745DC :                     smpsAlterPitch macro
(2)  774/   745DC :                     	smpsChangeTransposition	ALLARGS
(2)  775/   745DC :                     	endm
(2)  776/   745DC :                     
(2)  777/   745DC :                     smpsFMFlutter macro
(2)  778/   745DC :                     	smpsFMVolEnv	ALLARGS
