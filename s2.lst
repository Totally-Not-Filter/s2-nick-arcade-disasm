   16073/   19BEA :                     ; ===========================================================================
   16074/   19BEA :                     ; ---------------------------------------------------------------------------
   16075/   19BEA :                     ; This seems to be a subroutine that would've shifted the background blocks
   16076/   19BEA :                     ; of Chemical Plant Zone once the player reached a certain X position,
   16077/   19BEA :                     ; lasting exactly two screens. This can also be found in the final at
   16078/   19BEA :                     ; $40200 in the ROM, with the only difference being its level ID, which
   16079/   19BEA :                     ; was updated to match Chemical Plant's final ID ($0D instead of 02)
   16080/   19BEA :                     ;
   16081/   19BEA :                     ; To see the effect for yourself, add a branch to it at the
   16082/   19BEA :                     ; start of LoadTilesAsYouMove and change $FFFF7500/$FFFF7D00 to
   16083/   19BEA :                     ; $FFFF0000/$FFFF0800 (to make it more visible)
   16084/   19BEA :                     ; ---------------------------------------------------------------------------
   16085/   19BEA :                     
   16086/   19BEA :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
   16087/   19BEA :                     
   16088/   19BEA :                     
   16089/   19BEA :                     ; sub_1AC1E:
   16090/   19BEA :                     ShiftCPZBackground_PB:
   16091/   19BEA : 0C38 0002 FE10      		cmpi.b	#id_CPZ,(Current_Zone).w	; is this Chemical Plant Zone?
   16092/   19BF0 : 6702                		beq.s	.loc_1AC28			; if yes, branch
   16093/   19BF2 :                     
   16094/   19BF2 :                     .locret_1AC26:
   16095/   19BF2 : 4E75                		rts
   16096/   19BF4 :                     ; ===========================================================================
   16097/   19BF4 :                     ; this shifts all blocks of the chunks $EA-$ED and $FA-$FD one block to the
   16098/   19BF4 :                     ; left and the last block in each row (chunk $ED/$FD) to the beginning
   16099/   19BF4 :                     ; i.e. rotates the blocks to the left by one
   16100/   19BF4 :                     
   16101/   19BF4 :                     .loc_1AC28:
   16102/   19BF4 : 3038 EE00           		move.w	(Camera_X_pos).w,d0
   16103/   19BF8 : 0C40 1940           		cmpi.w	#$1940,d0
   16104/   19BFC : 65F4                		blo.s	.locret_1AC26
   16105/   19BFE : 0C40 1F80           		cmpi.w	#$1F80,d0
   16106/   19C02 : 64EE                		bhs.s	.locret_1AC26
   16107/   19C04 : 5338 F721           		subq.b	#1,(CPZ_UnkScroll_Timer).w
   16108/   19C08 : 6AE8                		bpl.s	.locret_1AC26
   16109/   19C0A : 11FC 0007 F721      		move.b	#7,(CPZ_UnkScroll_Timer).w
