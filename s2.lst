   12721/   1AA84 : 0040                		dc.w Dynamic_Null-DynArtCue_Index		; LZ
   12722/   1AA86 : 0136                		dc.w AnimCue_CPZ_Boss-DynArtCue_Index	; LZ
   12723/   1AA88 : 0040                		dc.w Dynamic_Null-DynArtCue_Index		; CPZ
