(1)  201/    1658 :                     
(1)  202/    1658 :                     ; the Nemesis decompressor uses prefix-free codes (no valid code is a prefix of a longer code)
(1)  203/    1658 :                     ; e.g. if 10 is a valid 2-bit code, 110 is a valid 3-bit code but 100 isn't
(1)  204/    1658 :                     ; also, when the actual compressed data is processed the high bit of each code is in bit position 7
(1)  205/    1658 :                     ; so the code needs to be bit-shifted appropriately over here before being used as a code table index
(1)  206/    1658 :                     ; additionally, the code needs multiple entries in the table because no masking is done during compressed data processing
(1)  207/    1658 :                     ; so if 11000 is a valid code then all indices of the form 11000XXX need to have the same entry
(1)  208/    1658 :                     NemBCT_ShortCode:
(1)  209/    1658 : 1018                		move.b	(a0)+,d0			; get code
(1)  210/    165A : E368                		lsl.w	d1,d0				; get index into code table
(1)  211/    165C : D040                		add.w	d0,d0				; shift so that high bit is in bit position 7
(1)  212/    165E : 7A01                		moveq	#1,d5
(1)  213/    1660 : E36D                		lsl.w	d1,d5
(1)  214/    1662 : 5345                		subq.w	#1,d5				; d5 = 2^d1 - 1
(1)  215/    1664 :                     
(1)  216/    1664 :                     NemBCT_ShortCode_Loop:
(1)  217/    1664 : 3387 0000           		move.w	d7,(a1,d0.w)			; store entry
(1)  218/    1668 : 5440                		addq.w	#2,d0				; increment index
(1)  219/    166A : 51CD FFF8           		dbf	d5,NemBCT_ShortCode_Loop	; repeat for required number of entries
(1)  220/    166E : 60BA                		bra.s	NemBCT_Loop
