    6558/    CB44 :                     RunObject:
    6559/    CB44 : 1010                		move.b	obID(a0),d0			; get the object's ID
    6560/    CB46 : 670C                		beq.s	loc_CB54			; if it's obj00, skip it
    6561/    CB48 : D040                		add.w	d0,d0
    6562/    CB4A : D040                		add.w	d0,d0				; d0 = object ID * 4
    6563/    CB4C : 227B 002C           		movea.l	Obj_Index-4(pc,d0.w),a1		; load the address of the object's code
    6564/    CB50 : 4E91                		jsr	(a1)				; dynamic call! to one of the the entries in Obj_Index
    6565/    CB52 : 7000                		moveq	#0,d0
    6566/    CB54 :                     
    6567/    CB54 :                     loc_CB54:
    6568/    CB54 : 41E8 0040           		lea	object_size(a0),a0		; load obj address
    6569/    CB58 : 51CF FFEA           		dbf	d7,RunObject
    6570/    CB5C : 4E75                		rts
    6571/    CB5E :                     ; ---------------------------------------------------------------------------
