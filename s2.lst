   12764/   1AACA :                     
   12765/   1AACA :                     loc_1AACA:
   12766/   1AACA : 5313                		subq.b	#1,(a3)				; Tick down frame duration
   12767/   1AACC : 6A42                		bpl.s	loc_1AB10			; If frame isn't over, move on to next script
   12768/   1AACE :                     
   12769/   1AACE : 7000                		moveq	#0,d0
   12770/   1AAD0 : 102B 0001           		move.b	1(a3),d0			; Get current frame
   12771/   1AAD4 : B02A 0006           		cmp.b	6(a2),d0			; Have we processed the last frame in the script?
   12772/   1AAD8 : 6506                		blo.s	loc_1AAE0
   12773/   1AADA : 7000                		moveq	#0,d0				; If so, reset to first frame
   12774/   1AADC : 1740 0001           		move.b	d0,1(a3)
   12775/   1AAE0 :                     
   12776/   1AAE0 :                     loc_1AAE0:
   12777/   1AAE0 : 522B 0001           		addq.b	#1,1(a3)			; Consider this frame processed; set counter to next frame
   12778/   1AAE4 : 1692                		move.b	(a2),(a3)			; Set frame duration to global duration value
   12779/   1AAE6 : 6A06                		bpl.s	loc_1AAEE
   12780/   1AAE8 :                     		; If script uses per-frame durations, use those instead
   12781/   1AAE8 : D040                		add.w	d0,d0
   12782/   1AAEA : 16B2 0009           		move.b	9(a2,d0.w),(a3)			; Set frame duration to current frame's duration value
   12783/   1AAEE :                     
   12784/   1AAEE :                     loc_1AAEE:
   12785/   1AAEE :                     		; Prepare for DMA transfer
   12786/   1AAEE :                     		; Get relative address of frame's art
   12787/   1AAEE : 1032 0008           		move.b	8(a2,d0.w),d0			; Get tile ID
   12788/   1AAF2 : EB48                		lsl.w	#5,d0				; Turn it into an offset
   12789/   1AAF4 :                     		; Get VRAM destination address
   12790/   1AAF4 : 342A 0004           		move.w	4(a2),d2
   12791/   1AAF8 :                     		; Get ROM source address
   12792/   1AAF8 : 2212                		move.l	(a2),d1				; Get start address of animated tile art
   12793/   1AAFA : 0281 00FF FFFF      		andi.l	#$FFFFFF,d1
   12794/   1AB00 : D280                		add.l	d0,d1				; Offset into art, to get the address of new frame
   12795/   1AB02 :                     		; Get size of art to be transferred
   12796/   1AB02 : 7600                		moveq	#0,d3
   12797/   1AB04 : 162A 0007           		move.b	7(a2),d3
   12798/   1AB08 : E94B                		lsl.w	#4,d3				; Turn it into actual size (in words)
   12799/   1AB0A :                     		; Use d1, d2 and d3 to queue art for transfer
   12800/   1AB0A : 4EB9 0000 14A0      		jsr	(QueueDMATransfer).l
   12801/   1AB10 :                     
   12802/   1AB10 :                     loc_1AB10:
   12803/   1AB10 : 102A 0006           		move.b	6(a2),d0			; Get total size of frame data
   12804/   1AB14 : 4A12                		tst.b	(a2)				; Is per-frame duration data present?
   12805/   1AB16 : 6A02                		bpl.s	loc_1AB1A			; If not, keep the current size; it's correct
   12806/   1AB18 : D000                		add.b	d0,d0				; Double size to account for the additional frame duration data
   12807/   1AB1A :                     
   12808/   1AB1A :                     loc_1AB1A:
   12809/   1AB1A : 5200                		addq.b	#1,d0
   12810/   1AB1C : 0240 00FE           		andi.w	#$FE,d0				; Round to next even address, if it isn't already
   12811/   1AB20 : 45F2 0008           		lea	8(a2,d0.w),a2			; Advance to next script in list
   12812/   1AB24 : 544B                		addq.w	#2,a3				; Advance to next script's slot in a3 (usually Anim_Counters)
   12813/   1AB26 : 51CE FFA2           		dbf	d6,loc_1AACA
