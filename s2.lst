(2)  756/   745DC :                     ; S1/S2 only coordination flag
(2)  757/   745DC :                     ; Sets D1L to maximum volume (minimum attenuation) and RR to maximum for operators 3 and 4 of FM1
(2)  758/   745DC :                     smpsMaxRelRate macro
(2)  759/   745DC :                     	if SonicDriverVer>=3
(2)  760/   745DC :                     		; Emulate it in S3/S&K/S3D driver
(2)  761/   745DC :                     		smpsFMICommand $88,$0F
(2)  762/   745DC :                     		smpsFMICommand $8C,$0F
(2)  763/   745DC :                     	else
(2)  764/   745DC :                     		dc.b	$F9
(2)  765/   745DC :                     	endif
(2)  766/   745DC :                     	endm
