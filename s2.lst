    6755/    CDAE :                     ; ===========================================================================
    6756/    CDAE :                     ; blank object, allocates its array
    6757/    CDAE :                     ; jmp_DeleteObject:
    6758/    CDAE :                     NullObject:
    6759/    CDAE : 6000 018A           		bra.w	DeleteObject
    6760/    CDB2 :                     
    6761/    CDB2 :                     ; ---------------------------------------------------------------------------
    6762/    CDB2 :                     ; Subroutine to make an object move and fall downward increasingly fast
    6763/    CDB2 :                     ; This moves the object horizontally and vertically
    6764/    CDB2 :                     ; and also applies gravity to its speed
    6765/    CDB2 :                     ; ---------------------------------------------------------------------------
    6766/    CDB2 :                     
    6767/    CDB2 :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
    6768/    CDB2 :                     
    6769/    CDB2 :                     ObjectMoveAndFall:
    6770/    CDB2 :                     ObjectFall:
    6771/    CDB2 : 2428 0008           		move.l	obX(a0),d2			; load x position
    6772/    CDB6 : 2628 000C           		move.l	obY(a0),d3			; load y position
    6773/    CDBA : 3028 0010           		move.w	obVelX(a0),d0			; load x speed
    6774/    CDBE : 48C0                		ext.l	d0
    6775/    CDC0 : E180                		asl.l	#8,d0				; shift velocity to line up with the middle 16 bits of the 32-bit position
