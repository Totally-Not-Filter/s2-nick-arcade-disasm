    1123/    1480 :                     ; Subroutine to transfer a plane map to VRAM
    1124/    1480 :                     ; ---------------------------------------------------------------------------
    1125/    1480 :                     
    1126/    1480 :                     ; control register:
    1127/    1480 :                     ;    CD1 CD0 A13 A12 A11 A10 A09 A08     (D31-D24)
    1128/    1480 :                     ;    A07 A06 A05 A04 A03 A02 A01 A00     (D23-D16)
    1129/    1480 :                     ;     ?   ?   ?   ?   ?   ?   ?   ?      (D15-D8)
    1130/    1480 :                     ;    CD5 CD4 CD3 CD2  ?   ?  A15 A14     (D7-D0)
    1131/    1480 :                     ;
    1132/    1480 :                     ;	A00-A15 - address
    1133/    1480 :                     ;	CD0-CD3 - code
    1134/    1480 :                     ;	CD4 - 1 if VRAM copy DMA mode. 0 otherwise.
    1135/    1480 :                     ;	CD5 - DMA operation
    1136/    1480 :                     ;
    1137/    1480 :                     ;	Bits CD3-CD0:
    1138/    1480 :                     ;	0000 - VRAM read
    1139/    1480 :                     ;	0001 - VRAM write
    1140/    1480 :                     ;	0011 - CRAM write
    1141/    1480 :                     ;	0100 - VSRAM read
    1142/    1480 :                     ;	0101 - VSRAM write
    1143/    1480 :                     ;	1000 - CRAM read
    1144/    1480 :                     ;
    1145/    1480 :                     ; d0 = control register
    1146/    1480 :                     ; d1 = width
    1147/    1480 :                     ; d2 = heigth
    1148/    1480 :                     ; a1 = source address
    1149/    1480 :                     
    1150/    1480 :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
